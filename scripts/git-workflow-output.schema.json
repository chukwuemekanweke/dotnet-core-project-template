{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "commitMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\r\\n]+$"
    },
    "prTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n]+$"
    },
    "prBody": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["commitMessage", "prTitle", "prBody"]
}
