# Non-secret placeholder values standing in for the host-owned
# /srv/backendprojecttemplate/production/stack.env, so the devops-toolkit
# release-config-check can render deploy/compose.production.yml on pull requests.
# Only the variables the Compose file requires are listed; the real values live on the host.
# Never put secrets here.
RUNTIME_SECRETS_APPLICATION=backendprojecttemplate
RUNTIME_SECRETS_ENVIRONMENT=prd
WEBAPI_SECRETS_GID=10001
CONSUMER_SECRETS_GID=10002
JOBS_SECRETS_GID=10003
DATABASE_MIGRATOR_SECRETS_GID=10004
