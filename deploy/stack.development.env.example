# Non-secret values standing in for the host-owned
# /srv/backendprojecttemplate/development/stack.env, so the devops-toolkit
# release-config-check can render deploy/compose.development.yml on pull requests.
# The group ids match the provisioned rsec-bpt-dev-* groups. Never put secrets here.
RUNTIME_SECRETS_APPLICATION=backendprojecttemplate
RUNTIME_SECRETS_ENVIRONMENT=dev
WEBAPI_SECRETS_GID=21001
CONSUMER_SECRETS_GID=21002
JOBS_SECRETS_GID=21003
DATABASE_MIGRATOR_SECRETS_GID=21004
